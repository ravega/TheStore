<% provide(:title, "Favourites") %>
<h1>My favourite articles</h1>

<% if @articles.empty? %>
  <p>
    You have no favourite articles yet.
    Select articles in the list and choose "Add selected to favourites".
  </p>
  <%= link_to 'Browse articles', articles_path, class: "btn btn-primary" %>
<% else %>
  <table class="table table-bordered table-striped">
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Owner</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @articles.each do |article| %>
        <tr>
          <td><%= article.title %></td>
          <td><%= article.owner %></td>
          <td>
            <%= link_to 'Show', article_path(article) %>
            <%= button_to 'Remove', favourite_path(article),
                          method: :delete,
                          class: "btn btn-default btn-sm",
                          'aria-label' => "Remove #{article.title} from favourites" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to 'Back to articles', articles_path, class: "btn btn-primary" %>
<% end %>
