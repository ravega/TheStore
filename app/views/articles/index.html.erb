<% provide(:title, "Articles Home") %>
<h1>Listing Articles:</h1>
<%= link_to 'New Article', new_article_path %>
<%= link_to 'List Owners', owner_path %>
<%= form_tag favourites_path do %>
<table border="1">
  <tr>
    <th>Select</th>
    <th>Title</th>
    <th>Text</th>
    <th>Owner</th>
  </tr>

  <% @articles.each do |article| %>
    <tr>
      <td>
        <%= check_box_tag 'article_ids[]', article.id, false, id: "article_ids_#{article.id}" %>
        <%= label_tag "article_ids_#{article.id}", "Select #{article.title}", class: "sr-only" %>
      </td>
      <td>
        <%= article.title %>
        <% if favourite_list.include?(article) %>
          <span class="label label-warning">Favourite</span>
        <% end %>
      </td>
      <td><%= article.text %></td>
      <td><%= article.owner %></td>
      <td><%= link_to 'Show', article_path(article) %></td>
      <td><%= link_to 'Edit', edit_article_path(article) %></td>
      <td><%= link_to 'Delete', article_path(article),
                       method: :delete,
                       data: { confirm: 'Are you sure?' } %></td>
    </tr>
  <% end %>
</table>
<p>
  <%= submit_tag 'Add selected to favourites', class: "btn btn-primary" %>
</p>
<% end %>



